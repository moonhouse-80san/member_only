<query id="getMemberOnlyDocumentSrls" action="select">
  <tables>
    <table name="document_extra_vars" />
  </tables>
  <columns distinct="distinct">
    <column name="document_srl" />
  </columns>
  <conditions>
    <condition operation="in" column="module_srl" var="module_srl" filter="number" />
    <condition operation="equal" column="eid" var="eid" notnull="notnull" pipe="and" />
    <condition operation="like" column="value" var="var_value" notnull="notnull" pipe="and" />
  </conditions>
</query>
